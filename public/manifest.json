{
  "manifest_version": 3,
  "name": "Tally",
  "version": "1.0.0",
  "description": "The fastest, simplest counter for Chrome.",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg"
    },
    "default_title": "Tally"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "increment": {
      "suggested_key": {
        "default": "Ctrl+Shift+Up",
        "mac": "Command+Shift+Up"
      },
      "description": "Increment counter"
    },
    "decrement": {
      "suggested_key": {
        "default": "Ctrl+Shift+Down",
        "mac": "Command+Shift+Down"
      },
      "description": "Decrement counter"
    },
    "reset": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Reset counter"
    }
  },
  "permissions": ["storage"],
  "chrome_url_overrides": {}
}
