{
  "manifest_version": 3,
  "name": "Tally",
  "version": "1.0.0",
  "description": "The fastest, simplest counter for Chrome.",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg"
    },
    "default_title": "Tally"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "chrome_url_overrides": {}
}
